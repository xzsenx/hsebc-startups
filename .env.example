# Скопируйте в .env: cp .env.example .env
# Значений по умолчанию достаточно, чтобы проект поднялся локально.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Подпись JWT. Для продакшена обязательно заменить на случайную строку:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Пароль демо-аккаунтов, которые создаются при первом запуске пустой базы.
SEED_PASSWORD=demo1234

CORS_ORIGINS=http://localhost:8080,http://localhost:5173
