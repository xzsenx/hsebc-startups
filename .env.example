# Скопируйте в .env: cp .env.example .env
# Значений по умолчанию достаточно, чтобы проект поднялся локально.

# development | production. В production приложение откажется стартовать
# с JWT_SECRET по умолчанию или с включёнными демо-аккаунтами.
ENVIRONMENT=development

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Подпись JWT. Для production — случайная строка от 32 символов:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Демо-аккаунты создаются при первом запуске пустой базы. В production — false.
SEED_DEMO=true
SEED_PASSWORD=demo1234

# Порт, на котором приложение видно снаружи.
FRONTEND_PORT=8080

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Swagger на /api/docs. В production обычно выключают.
DOCS_ENABLED=true
